---
export interface Props {
  title?: string;
  class?: string;
  'data-size'?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  'data-orientation'?: 'vertical' | 'horizontal';
  'data-viewport'?: 'desktop' | 'tablet' | 'mobile';
}

const {
  title = 'Preview',
  class: className = '',
  'data-size': dataSize,
  'data-orientation': dataOrientation,
  'data-viewport': dataViewport
} = Astro.props as Props;
---

<section
  class:list={['preview', className]}
  data-size={dataSize}
  data-orientation={dataOrientation}
  data-viewport={dataViewport}
>
  <header class="preview__header">
    <span class="preview__label">
      <svg
        class="preview__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      {title}
    </span>
    <div class="preview__actions" aria-hidden="true">
      <!--
        Extension points for future features:
        - Tabs: Preview | HTML | CSS | JS
        - Copy source code button
        - Viewport toggle: desktop | tablet | mobile
        - Fullscreen / isolated view
      -->
    </div>
  </header>

  <div class="preview__body" role="region" aria-label={`${title} example`}>
    <slot />
  </div>

  <!--
    Future extension: collapsible source code panel
    <details class="preview__source">
      <summary class="preview__source-toggle">Source code</summary>
      <div class="preview__source-content">
        <slot name="code" />
      </div>
    </details>
  -->
</section>

<style>
  .preview {
    --_radius: 0.5rem;
    --_border-width: 1px;
    --_border: var(--_border-width) solid var(--sl-color-hairline-light);
    --_header-bg: var(--sl-color-gray-7, var(--sl-color-gray-6));
    --_body-bg: var(--sl-color-bg);
    --_label-color: var(--sl-color-gray-3);
    --_icon-color: var(--sl-color-gray-4);

    position: relative;
    border: var(--_border);
    border-radius: var(--_radius);
    overflow: hidden;
    background: var(--_body-bg);
    box-shadow: var(--sl-shadow-sm);
    margin-block: 1.5rem;
  }

  .preview__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.375rem 0.75rem;
    background: var(--_header-bg);
    border-bottom: var(--_border);
    min-height: 2rem;
  }

  .preview__label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--sl-text-2xs);
    font-weight: 600;
    color: var(--_label-color);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    user-select: none;
    line-height: 1;
  }

  .preview__icon {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--_icon-color);
    flex-shrink: 0;
  }

  .preview__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .preview__body {
    padding: 1.5rem;
    background: var(--_body-bg);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    display: flow-root;
  }

  @media (max-width: 50rem) {
    .preview__body {
      padding: 1rem;
    }
  }

  .preview[data-size='sm'] .preview__body {
    max-width: 20rem;
  }
  .preview[data-size='md'] .preview__body {
    max-width: 30rem;
  }
  .preview[data-size='lg'] .preview__body {
    max-width: 40rem;
  }
  .preview[data-size='xl'] .preview__body {
    max-width: 50rem;
  }
  .preview[data-size='full'] .preview__body {
    max-width: none;
  }

  .preview[data-orientation='horizontal'] .preview__body {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-start;
  }

  .preview[data-viewport='mobile'] .preview__body {
    max-width: 23.4375rem;
    margin-inline: auto;
  }
  .preview[data-viewport='tablet'] .preview__body {
    max-width: 48rem;
    margin-inline: auto;
  }

  .preview__body:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
    border-radius: calc(var(--_radius) - var(--_border-width));
  }

  @media (prefers-reduced-motion: reduce) {
    .preview {
      box-shadow: none;
    }
  }
</style>
